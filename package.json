{
  "name": "sharklication",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/validate-assets.mjs",
    "typecheck": "tsc -b",
